# ========================================================================
# 🍽️ Restaurant Menu Management System - Environment Configuration
# Author: 7AZZANI (https://7azzani.com)
# ========================================================================

# Django Secret Key (Generate a secure secret key for production)
SECRET_KEY=django-insecure-change-this-in-production-demo-key-12345

# Debug Mode (Set to False in production)
DEBUG=True

# Allowed Hosts (Comma-separated in production, e.g. example.com,www.example.com)
ALLOWED_HOSTS=*

# Database URL
# Default (Empty): Uses SQLite (db.sqlite3) out of the box
# For PostgreSQL, uncomment below:
# DATABASE_URL=postgres://postgres:password@localhost:5432/rms_db

# Redis URL for Django Channels (Optional)
# Default (Empty): Uses InMemoryChannelLayer for zero-configuration local development
# For production Redis:
# REDIS_URL=redis://localhost:6379

# WebPush VAPID Keys (Optional for browser push notifications)
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_ADMIN_EMAIL=admin@example.com
